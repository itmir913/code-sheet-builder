# 의존성
node_modules/
.npm/

# 빌드 산출물. npm run build 로 언제든 다시 만든다.
dist/
*.zip

# 오프라인 번들을 로컬에서 확인할 때 쓰는 임시 폴더
.offline-test/

# IDE / 에디터
# .idea 안은 개인 설정이라 무시한다. 다만 실행 구성(ci/dev/build)은 저장소가
# 쓰는 명령 셋과 같은 것이라 함께 공유한다.
#
# .idea/ 가 아니라 .idea/* 로 적은 이유: 디렉터리 자체를 무시하면 git 이 그 안으로
# 내려가지 않아서, 아래 ! 규칙으로도 되살릴 수 없다.
.idea/*
!.idea/runConfigurations/
.vscode/

# Claude Code 로컬 설정
.claude/

# OS
.DS_Store
Thumbs.db

# 로그 / 환경변수
*.log
.env
.env.*

# 테스트 산출물
coverage/

# 주의: public/ 은 무시하지 않는다. 예제코드 zip이 거기 들어 있고,
# 빌드가 그대로 dist/ 로 복사한다.
